{
  "name": "mushy-lint",
  "version": "0.0.1",
  "description": "Provider-neutral semantic classification over tree-sitter source targets",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Nick Pisani",
  "bin": {
    "mushy-lint": "src/cli.ts"
  },
  "scripts": {
    "build:bin": "bun build ./src/cli.ts --compile --outfile dist/mushy-lint",
    "build:grammars": "bun scripts/build-grammars.ts",
    "lint": "oxlint --ignore-pattern 'tests/fixtures/**' .",
    "test": "bun scripts/generate-nix-deps.ts --check && bun test tests/",
    "nix:deps": "bun scripts/generate-nix-deps.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "js-yaml": "^5.4.2",
    "web-tree-sitter": "0.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "^1.4.2",
    "oxlint": "^1.86.0",
    "typescript": "5.9"
  }
}
